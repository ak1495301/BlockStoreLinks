<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/appIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/app_icon"
            android:layout_marginEnd="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/appName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/actionToggle"
            app:layout_constraintStart_toEndOf="@id/appIcon"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/appPackage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@+id/actionToggle"
            app:layout_constraintStart_toEndOf="@id/appIcon"
            app:layout_constraintTop_toBottomOf="@id/appName" />

        <TextView
            android:id="@+id/attempts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@+id/actionToggle"
            app:layout_constraintStart_toEndOf="@id/appIcon"
            app:layout_constraintTop_toBottomOf="@id/appPackage" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/actionToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actionAllow"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_allow" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actionAsk"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_ask" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actionDeny"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_deny" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <Button
            android:id="@+id/redirectButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/redirect_to"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/actionToggle" />

        <TextView
            android:id="@+id/redirectTarget"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/redirectButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/attempts" />

        <Button
            android:id="@+id/allowlistButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/allowlist"
            app:layout_constraintEnd_toStartOf="@id/resetAttempts"
            app:layout_constraintTop_toBottomOf="@id/redirectButton" />

        <Button
            android:id="@+id/resetAttempts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reset_attempts"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/redirectButton" />

        <TextView
            android:id="@+id/allowlistCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/allowlistButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/redirectTarget" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
